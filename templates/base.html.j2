{# 페이지 껍데기. 요약·제목·태그는 전부 autoescape로 나간다 — |safe 금지(R-11). #}
<!doctype html>
<html lang="ko">
<meta charset="utf-8">
<title>{{ page_title }}</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  :root {
    color-scheme: light dark;
    --fg: #16181d; --muted: #5f6672; --line: #e2e5ea;
    --bg: #ffffff; --card: #f7f8fa; --accent: #1a56b8; --warn-bg: #fff4e0; --warn-fg: #7a4a00;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --fg: #e6e8ec; --muted: #9aa1ad; --line: #2b2f37;
      --bg: #14161a; --card: #1c1f26; --accent: #7fb0ff; --warn-bg: #3a2b12; --warn-fg: #ffd79a;
    }
  }
  * { box-sizing: border-box; }
  body {
    font-family: system-ui, -apple-system, "Apple SD Gothic Neo", "Noto Sans KR", sans-serif;
    max-width: 54rem; margin: 0 auto; padding: 2.5rem 1.25rem 5rem;
    line-height: 1.7; color: var(--fg); background: var(--bg);
    overflow-wrap: break-word; word-break: break-word;   /* 긴 제목·URL이 가로 스크롤을 만들지 않게 */
  }
  a { color: var(--accent); }
  h1 { font-size: 1.7rem; margin: 0 0 .3rem; }
  h2 { font-size: 1.25rem; margin: 2.6rem 0 .2rem; padding-bottom: .35rem;
       border-bottom: 2px solid var(--line); }
  h3 { font-size: .96rem; margin: 1.6rem 0 .6rem; color: var(--muted);
       font-weight: 600; letter-spacing: .01em; }
  .muted { color: var(--muted); font-size: .9rem; }
  .banner { background: var(--warn-bg); color: var(--warn-fg); border-radius: .5rem;
            padding: .8rem 1rem; margin: 1.2rem 0; font-size: .95rem; }
  .entry { border-top: 1px solid var(--line); padding: .95rem 0; }
  .entry:first-of-type { border-top: none; }
  .entry-title { font-size: 1.02rem; font-weight: 600; line-height: 1.45; margin: 0 0 .3rem; }
  .stars { color: #d99a00; letter-spacing: .06em; margin-right: .4rem; font-size: .95rem; }
  .meta { font-size: .84rem; color: var(--muted); margin: .1rem 0 .45rem; }
  .meta span + span::before { content: " · "; }
  .summary { margin: .35rem 0 .5rem; font-size: .95rem; }
  .no-abstract { color: var(--muted); font-style: italic; font-size: .92rem; }
  .tags { display: flex; flex-wrap: wrap; gap: .3rem; margin-top: .35rem; }
  .tag { background: var(--card); border: 1px solid var(--line); border-radius: 1rem;
         padding: .08rem .55rem; font-size: .77rem; color: var(--muted); }
  .tag.venue { border-color: var(--accent); color: var(--accent); font-weight: 600; }
  footer { margin-top: 4rem; padding-top: 1.2rem; border-top: 1px solid var(--line);
           font-size: .82rem; color: var(--muted); }
  footer dl { display: grid; grid-template-columns: max-content 1fr; gap: .15rem .8rem; margin: .5rem 0; }
  footer dt { font-weight: 600; }
  footer dd { margin: 0; }
  nav { margin: .6rem 0 0; font-size: .9rem; }
</style>
<body>
{% block body %}{% endblock %}

<footer>
  {# AC-15: 서버가 멈춰도 사이트는 살아 있다. 낡았다는 사실이 여기 보여야 한다. #}
  <dl>
    <dt>데이터 기준일</dt><dd>{{ meta.data_date }}</dd>
    <dt>생성 시각</dt><dd>{{ meta.generated_kst }} KST</dd>
    <dt>수집</dt><dd>{{ meta.source_line }}</dd>
    <dt>게시</dt><dd>{{ meta.published_count }}건{% if meta.title_only_count %} (그중 초록 미확보 {{ meta.title_only_count }}건){% endif %}</dd>
    {% if meta.shortfall_line %}<dt>축별 미달</dt><dd>{{ meta.shortfall_line }}</dd>{% endif %}
    {% if meta.summary_failed_count %}<dt>요약 실패</dt><dd>{{ meta.summary_failed_count }}건 (논문은 게시, 제목만 표시)</dd>{% endif %}
    {% if meta.excluded_count %}<dt>제외</dt><dd>{{ meta.excluded_count }}건 (요약 검증 실패·판정 불가)</dd>{% endif %}
    {% if meta.truncated_count %}<dt>절삭</dt><dd>상한 초과로 {{ meta.truncated_count }}건 제외</dd>{% endif %}
    {% if meta.boosted_count %}<dt>학회 부스트</dt><dd>{{ meta.boosted_count }}건</dd>{% endif %}
  </dl>
  <nav><a href="{{ rel }}index.html">최신</a> · <a href="{{ rel }}archive/index.html">아카이브</a></nav>
</footer>
