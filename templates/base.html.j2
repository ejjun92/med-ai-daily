{# 페이지 껍데기.

   디자인은 gist-ailab/gail-daily-news의 뉴모피즘 시스템을 따른다 — 사용자가
   처음에 그 사이트를 모델로 제시했다. 입체 그림자로 카드를 띄우고, 별점은
   주황, 강조색은 청록, 푸터는 어둡게 간다.

   요약·제목·태그는 전부 autoescape로 나간다 — |safe 금지 (R-11). #}
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ page_title }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Noto+Sans+KR:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root {
  --primary: #006666;
  --surface: #E7E5E4;
  --surface-card: #E7E5E4;
  --text: #1E2938;
  --text-secondary: #4A5568;
  --text-tertiary: #8494A7;
  --accent: #006666;
  --accent-hover: #004D4D;
  --star-filled: #FE9900;
  --star-empty: #C4C4C4;
  --surface-highlight: #EDE9E3;
  --badge-bg: #D9D7D5;
  --badge-text: #006666;
  --warning: #FE9900;
  --danger: #FF2157;
  --gradient-start: #006666;
  --gradient-mid: #008080;
  --gradient-end: #00A3A3;
  --header-text: #F1F2F5;
  --footer-bg: #1E2938;
  --footer-text: #8494A7;
  --neu-light: rgba(255,255,255,0.7);
  --neu-dark: rgba(0,0,0,0.15);
  --shadow-raised: 6px 6px 12px var(--neu-dark), -6px -6px 12px var(--neu-light);
  --shadow-raised-sm: 3px 3px 6px var(--neu-dark), -3px -3px 6px var(--neu-light);
  --shadow-inset: inset 3px 3px 6px var(--neu-dark), inset -3px -3px 6px var(--neu-light);
  --shadow-hover: 8px 8px 16px var(--neu-dark), -8px -8px 16px var(--neu-light);
  --radius-sm: 12px;
  --radius-md: 16px;
  --radius-lg: 20px;
}
/* 테마는 세 상태다: 아무 표시 없음(브라우저 설정 따름), data-theme="light",
   data-theme="dark". 토글이 양방향으로 이기려면 세 경우를 모두 적어야 한다.
   토큰만 다시 정의하고, 컴포넌트는 항상 토큰을 통해 색을 쓴다 —
   미디어 쿼리 안에서만 정의된 색은 표시 없는 상태에서 적용되지 않는다. */
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --primary: #00CCCC;
    --surface: #1A202C;
    --surface-card: #1A202C;
    --text: #F1F2F5;
    --text-secondary: #CBD5E0;
    --text-tertiary: #8494A7;
    --accent: #00CCCC;
    --accent-hover: #33E0E0;
    --star-filled: #FEB800;
    --star-empty: #4A5568;
    --surface-highlight: #222C3C;
    --badge-bg: #2D3748;
    --badge-text: #00CCCC;
    --gradient-start: #0D1117;
    --gradient-mid: #1A202C;
    --gradient-end: #004D4D;
    --header-text: #E2E8F0;
    --footer-bg: #0D1117;
    --footer-text: #718096;
    --neu-light: rgba(255,255,255,0.05);
    --neu-dark: rgba(0,0,0,0.5);
  }
}
:root[data-theme="dark"] {
    --primary: #00CCCC;
    --surface: #1A202C;
    --surface-card: #1A202C;
    --text: #F1F2F5;
    --text-secondary: #CBD5E0;
    --text-tertiary: #8494A7;
    --accent: #00CCCC;
    --accent-hover: #33E0E0;
    --star-filled: #FEB800;
    --star-empty: #4A5568;
    --surface-highlight: #222C3C;
    --badge-bg: #2D3748;
    --badge-text: #00CCCC;
    --gradient-start: #0D1117;
    --gradient-mid: #1A202C;
    --gradient-end: #004D4D;
    --header-text: #E2E8F0;
    --footer-bg: #0D1117;
    --footer-text: #718096;
    --neu-light: rgba(255,255,255,0.05);
    --neu-dark: rgba(0,0,0,0.5);
}

/* ── 테마 토글 ────────────────────────────────────── */
.theme-toggle {
  position: fixed; bottom: 24px; right: 24px;
  width: 44px; height: 44px; border-radius: 50%; border: none;
  background: var(--surface); box-shadow: var(--shadow-raised);
  cursor: pointer; display: flex; align-items: center; justify-content: center;
  font-size: 1.2rem; transition: transform .2s, box-shadow .2s; z-index: 100;
}
.theme-toggle:hover { transform: scale(1.08); box-shadow: var(--shadow-hover); }
.theme-toggle:active { box-shadow: var(--shadow-inset); transform: scale(.96); }
.theme-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
.theme-toggle .icon-light, .theme-toggle .icon-dark { display: none; }
/* 표시가 없으면 '브라우저 설정 따름' 상태임을 반달로 알린다 */
:root:not([data-theme]) .theme-toggle::after { content: '\1F313'; }
:root[data-theme="light"] .theme-toggle .icon-light { display: inline; }
:root[data-theme="dark"] .theme-toggle .icon-dark { display: inline; }
@media (prefers-reduced-motion: reduce) {
  .theme-toggle, .item { transition: none; }
  .item:hover { transform: none; }
}

* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  margin: 0;
  font-family: 'Noto Sans KR', system-ui, -apple-system, sans-serif;
  background: var(--surface);
  color: var(--text);
  line-height: 1.65;
  overflow-wrap: break-word;
  word-break: break-word;
}
a { color: var(--accent); text-decoration: none; }
a:hover { color: var(--accent-hover); text-decoration: underline; }

/* ── hero ─────────────────────────────────────────── */
.hero {
  position: relative;
  background: linear-gradient(135deg, var(--gradient-start), var(--gradient-mid) 55%, var(--gradient-end));
  color: var(--header-text);
  padding: 2.6rem 1.25rem 2.2rem;
  text-align: center;
}
.hero-nav-link {
  position: absolute; top: 1rem; right: 1.25rem; z-index: 2;
  color: var(--header-text); font-family: 'JetBrains Mono', monospace;
  font-size: .72rem; font-weight: 500; padding: .4rem .8rem; border-radius: 999px;
  background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.25);
  backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
  transition: background .2s, transform .2s; white-space: nowrap;
}
.hero-nav-link:hover { background: rgba(255,255,255,.22); transform: translateY(-1px); text-decoration: none; }
@media (max-width: 30rem) { .hero-nav-link { position: static; display: inline-block; margin-bottom: .8rem; } }

/* ── 상단 액션 카드 (지난 뉴스 / GitHub) ──────────── */
.page-actions {
  display: grid; grid-template-columns: minmax(0,1.35fr) minmax(240px,.65fr);
  gap: 1rem; margin-bottom: 2rem;
}
.action-card {
  min-width: 0; padding: 1.1rem 1.2rem; border-radius: var(--radius-md);
  background: var(--surface-card); box-shadow: var(--shadow-raised-sm);
}
.action-card h2 { margin: 0 0 .35rem; font-size: .95rem; font-weight: 700; }
.action-card p { margin: 0; font-size: .78rem; color: var(--text-secondary); }
.archive-controls { display: flex; align-items: center; gap: .55rem; margin-top: .85rem; }
.archive-date {
  min-width: 0; flex: 1; height: 38px; padding: 0 .75rem;
  border: 0; border-radius: 10px; outline: none;
  background: var(--surface); box-shadow: var(--shadow-inset);
  color: var(--text); color-scheme: light dark;
  font-family: 'JetBrains Mono', monospace; font-size: .72rem;
}
.archive-date:focus-visible { box-shadow: var(--shadow-inset), 0 0 0 2px var(--accent); }
.action-button {
  display: inline-flex; align-items: center; justify-content: center;
  min-height: 38px; padding: .55rem .9rem; border: 0; border-radius: 10px;
  background: var(--primary); color: var(--header-text);
  font-family: 'Noto Sans KR', sans-serif; font-weight: 700; font-size: .74rem;
  white-space: nowrap; cursor: pointer; text-decoration: none;
  box-shadow: var(--shadow-raised-sm);
  transition: transform .2s, box-shadow .2s, background .2s;
}
.action-button:hover { transform: translateY(-1px); box-shadow: var(--shadow-raised); text-decoration: none; }
.secondary-links { display: flex; flex-wrap: wrap; gap: .45rem .9rem; margin-top: .7rem; }
.text-link { color: var(--primary); font-size: .7rem; font-weight: 700; }
.github-card {
  display: flex; flex-direction: column; justify-content: space-between;
  background: var(--surface-highlight);
}
.github-actions { display: grid; gap: .55rem; margin-top: .85rem; }
.github-button { width: 100%; background: #24292f; color: #fff; }
.feedback-button { width: 100%; }
.visually-hidden {
  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
}
@media (max-width: 46rem) {
  .page-actions { grid-template-columns: 1fr; gap: .8rem; }
  .archive-controls { align-items: stretch; }
}

.hero-inner { max-width: 58rem; margin: 0 auto; }
.hero .icon { font-size: 2rem; line-height: 1; }
.hero h1 {
  margin: .5rem 0 .3rem;
  font-family: 'Space Mono', monospace;
  font-size: clamp(1.5rem, 4.5vw, 2.3rem);
  font-weight: 700; letter-spacing: -.01em;
}
.hero h1 .title-line { display: block; }
.hero .subtitle { font-size: .92rem; opacity: .92; }
.hero .stats {
  display: flex; flex-wrap: wrap; justify-content: center;
  gap: .4rem; margin-top: 1rem;
}
.hero .stats span {
  font-family: 'JetBrains Mono', monospace; font-size: .68rem;
  padding: .2rem .6rem; border-radius: 999px;
  background: rgba(255,255,255,.16);
}

/* ── container ────────────────────────────────────── */
.container { max-width: 58rem; margin: 0 auto; padding: 1.6rem 1.25rem 3rem; }

/* ── 접이식 안내 ──────────────────────────────────── */
.feed-guide {
  background: var(--surface-card); border-radius: var(--radius-md);
  box-shadow: var(--shadow-raised); padding: .9rem 1.2rem; margin-bottom: 1.4rem;
}
.feed-guide > summary {
  cursor: pointer; font-weight: 600; font-size: .9rem; color: var(--text-secondary);
  list-style: none;
}
.feed-guide > summary::-webkit-details-marker { display: none; }
.feed-guide > summary::before { content: "▸ "; color: var(--accent); }
.feed-guide[open] > summary::before { content: "▾ "; }
.guide-body { margin-top: .9rem; font-size: .82rem; color: var(--text-secondary); }
.guide-title {
  font-weight: 700; color: var(--text); margin: 1rem 0 .3rem;
  font-size: .84rem; letter-spacing: .01em;
}
.guide-title:first-child { margin-top: 0; }
.importance-scale div { display: flex; gap: .6rem; align-items: baseline; margin: .15rem 0; }
.importance-scale strong { color: var(--star-filled); font-size: .78rem; white-space: nowrap; }
.guide-source-row { display: grid; grid-template-columns: minmax(0,15rem) 1fr; gap: .2rem .9rem; margin: .2rem 0; }
.guide-source-category { color: var(--text); font-weight: 500; }
@media (max-width: 34rem) { .guide-source-row { grid-template-columns: 1fr; } }

.banner {
  background: var(--surface-card); color: var(--warning);
  border-radius: var(--radius-md); box-shadow: var(--shadow-inset);
  padding: .85rem 1.1rem; margin-bottom: 1.2rem; font-size: .88rem;
}

/* ── 섹션 ─────────────────────────────────────────── */
.section { margin-top: 2.2rem; }
.section-header h2 {
  margin: 0 0 .2rem; font-size: 1.12rem; font-weight: 700;
  display: flex; align-items: center; gap: .5rem; flex-wrap: wrap;
}
.section-header .count {
  font-family: 'JetBrains Mono', monospace; font-size: .68rem;
  color: var(--badge-text); background: var(--badge-bg);
  padding: .1rem .5rem; border-radius: 999px; box-shadow: var(--shadow-raised-sm);
}
.section-description { font-size: .8rem; color: var(--text-tertiary); margin: 0 0 .9rem; }
.subsection {
  font-size: .82rem; font-weight: 600; color: var(--text-secondary);
  margin: 1.1rem 0 .5rem; display: flex; align-items: center; gap: .4rem;
}

/* ── 항목 카드 ────────────────────────────────────── */
.item {
  width: 100%; min-width: 0;
  padding: 1.1rem 1.3rem; margin-bottom: 10px;
  background: var(--surface-card); border: none;
  border-radius: var(--radius-md); box-shadow: var(--shadow-raised);
  transition: box-shadow .25s ease, transform .2s ease;
}
.item:hover { box-shadow: var(--shadow-hover); transform: translateY(-1px); }
.item-title { font-size: .98rem; font-weight: 600; line-height: 1.45; margin-bottom: .35rem; }
.item-meta { display: flex; flex-wrap: wrap; align-items: center; gap: .45rem; margin-bottom: .5rem; }
.badge {
  font-family: 'JetBrains Mono', monospace; font-size: .62rem;
  padding: .12rem .5rem; border-radius: 999px;
  background: var(--badge-bg); color: var(--badge-text);
  box-shadow: var(--shadow-raised-sm);
}
.item-date { font-family: 'JetBrains Mono', monospace; font-size: .68rem; color: var(--text-tertiary); }
.item-authors { font-size: .68rem; color: var(--text-tertiary); }
.stars { font-size: .78rem; letter-spacing: 1px; white-space: nowrap; cursor: help; }
.stars .filled { color: var(--star-filled); }
.stars .empty { color: var(--star-empty); }
.item.highlight { box-shadow: var(--shadow-hover); }
.item.highlight .stars .filled { color: var(--danger); }
.item-summary { font-size: .88rem; color: var(--text-secondary); margin: 0 0 .5rem; }
.item-summary.missing { font-style: italic; color: var(--text-tertiary); }
.item-taxonomy { display: flex; flex-wrap: wrap; gap: .28rem; }
.taxonomy-chip {
  display: inline-flex; align-items: center; min-width: 0;
  padding: .16rem .5rem; border-radius: 999px;
  font-family: 'JetBrains Mono', 'Noto Sans KR', monospace;
  font-size: .6rem; line-height: 1.35; overflow-wrap: anywhere;
  background: var(--badge-bg); color: var(--text-secondary);
  box-shadow: var(--shadow-raised-sm);
}
.taxonomy-chip.taxonomy-venue { color: var(--badge-text); font-weight: 700; }

/* ── 푸터 ─────────────────────────────────────────── */
footer {
  background: var(--footer-bg); color: var(--footer-text);
  padding: 2rem 1.25rem 2.6rem; margin-top: 3rem;
}
.footer-inner { max-width: 58rem; margin: 0 auto; font-size: .78rem; }
.footer-inner dl {
  display: grid; grid-template-columns: max-content 1fr;
  gap: .18rem .9rem; margin: .6rem 0 1rem;
}
.footer-inner dt { font-weight: 600; color: #CBD5E0; }
.footer-inner dd { margin: 0; }
.footer-inner nav a { color: var(--primary); margin-right: .8rem; }
.empty-note { color: var(--text-tertiary); font-size: .9rem; }
</style>
</head>
<body>
<div class="hero">
  <a class="hero-nav-link" href="https://github.com/ejjun92/med-ai-daily" target="_blank" rel="noopener">GitHub ↗</a>
  <div class="hero-inner">
    <div class="icon">🧠</div>
    <h1><span class="title-line">{{ site_title }}</span></h1>
    <div class="subtitle">{{ meta.data_date }} — 뇌신호·수술영상 중심, 의료 AI 큐레이션</div>
    <div class="stats">
      <span>게시 {{ meta.published_count }}건</span>
      {% for axis, n in axis_counts %}<span>{{ axis.label }} {{ n }}</span>{% endfor %}
      <span>소스 3개</span>
      <span>매일 12:00 KST 업데이트</span>
      <span>중요도 정렬</span>
    </div>
  </div>
</div>

<div class="container">
{% block actions %}
<section class="page-actions" aria-label="지난 기록과 저장소">
  <div class="action-card">
    <h2>📚 지난 뉴스 보기</h2>
    <p>날짜를 선택해 그날의 의료 AI 리서치 다이제스트를 확인하세요.</p>
    <form class="archive-controls" id="archive-form">
      <label class="visually-hidden" for="archive-date">날짜 선택</label>
      <input class="archive-date" id="archive-date" type="date"
             {% if archive_min %}min="{{ archive_min }}" {% endif %}max="{{ meta.data_date }}"
             value="{{ meta.data_date }}" required>
      <button class="action-button" type="submit">기록 열기 ↗</button>
    </form>
    <div class="secondary-links">
      <a class="text-link" href="{{ rel }}index.html">최신 기록 보기 →</a>
      <a class="text-link" href="{{ rel }}archive/index.html">전체 아카이브 목록 →</a>
    </div>
  </div>
  <aside class="action-card github-card">
    <div>
      <h2>⭐ 함께 개선해 주세요</h2>
      <p>분류가 어긋나거나 놓친 논문이 있으면 Issue로 알려주세요. 큐레이션을 고치는 데 큰 도움이 됩니다.</p>
    </div>
    <div class="github-actions">
      <a class="action-button github-button" href="https://github.com/ejjun92/med-ai-daily" target="_blank" rel="noopener">GitHub에서 Star 남기기 ↗</a>
      <a class="action-button feedback-button" href="https://github.com/ejjun92/med-ai-daily/issues" target="_blank" rel="noopener">피드백 Issue 남기기 ↗</a>
    </div>
  </aside>
</section>
<script>
(function () {
  var form = document.getElementById('archive-form');
  if (!form) return;
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var d = document.getElementById('archive-date').value;
    // 오늘치는 아카이브가 아니라 최신 페이지다.
    if (d === {{ meta.data_date | tojson }}) { window.location.href = {{ (rel ~ 'index.html') | tojson }}; return; }
    if (d) window.location.href = {{ (rel ~ 'archive/') | tojson }} + encodeURIComponent(d) + '.html';
  });
})();
</script>
{% endblock %}
{% block guide %}{% endblock %}
{% block body %}{% endblock %}
</div>

<footer>
  <div class="footer-inner">
    {# AC-15: 서버가 멈춰도 사이트는 살아 있다. 낡았다는 사실이 여기 보여야 한다. #}
    <dl>
      <dt>데이터 기준일</dt><dd>{{ meta.data_date }}</dd>
      <dt>생성 시각</dt><dd>{{ meta.generated_kst }} KST</dd>
      <dt>수집</dt><dd>{{ meta.source_line }}</dd>
      <dt>게시</dt><dd>{{ meta.published_count }}건{% if meta.title_only_count %} (그중 초록 미확보 {{ meta.title_only_count }}건){% endif %}</dd>
      {% if meta.shortfall_line %}<dt>축별 미달</dt><dd>{{ meta.shortfall_line }}</dd>{% endif %}
      {% if meta.summary_failed_count %}<dt>요약 실패</dt><dd>{{ meta.summary_failed_count }}건 (논문은 게시, 제목만 표시)</dd>{% endif %}
      {% if meta.excluded_count %}<dt>관련 없음</dt><dd>{{ meta.excluded_count }}건 (분류 단계에서 제외)</dd>{% endif %}
      {% if meta.truncated_count %}<dt>절삭</dt><dd>상한 초과로 {{ meta.truncated_count }}건 제외</dd>{% endif %}
      {% if meta.capped_sources %}<dt>⚠️ 수집 상한</dt><dd>{{ meta.capped_sources | join(", ") }} — 상한에 걸려 일부 논문을 못 가져왔습니다</dd>{% endif %}
      {% if meta.boosted_count %}<dt>학회 부스트</dt><dd>{{ meta.boosted_count }}건</dd>{% endif %}
    </dl>
    <nav><a href="{{ rel }}index.html">최신</a><a href="{{ rel }}archive/index.html">지난 뉴스 전체</a></nav>
  </div>
</footer>

<button class="theme-toggle" onclick="toggleTheme()" aria-label="밝은/어두운 테마 전환">
  <span class="icon-light">&#9728;&#65039;</span>
  <span class="icon-dark">&#9789;</span>
</button>
<script>
(function () {
  // 깜빡임을 막으려면 렌더 전에 적용해야 하지만, 스크립트를 문서 끝에 두는
  // 편이 안전하다 — 여기서는 배경색만 바뀌므로 체감 차이가 거의 없다.
  var saved = null;
  try { saved = localStorage.getItem('theme'); } catch (e) { /* 사생활 모드 */ }
  if (saved === 'dark' || saved === 'light') {
    document.documentElement.setAttribute('data-theme', saved);
  }
})();
function toggleTheme() {
  var html = document.documentElement;
  var current = html.getAttribute('data-theme');
  var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  // 표시가 없으면 지금 보이는 것의 반대로 간다
  var next = !current ? (prefersDark ? 'light' : 'dark')
                      : (current === 'dark' ? 'light' : 'dark');
  html.setAttribute('data-theme', next);
  try { localStorage.setItem('theme', next); } catch (e) { /* 무시 */ }
}
</script>
</body>
</html>
